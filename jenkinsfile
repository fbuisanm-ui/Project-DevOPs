// Jenkinsfile (esquema mínimo)

pipeline {
    agent any

    stages {
        stage('Build') {
            steps {
                sh 'docker build -t project-devops:1.0 .'
            }
        }

        stage('Load Image') {
            steps {
                sh 'sudo -u ubuntu -H minikube image load project-devops:1.0'
            }
        }

        stage('Deploy') {
            steps {
                sh 'kubectl apply -f k8s/deployment.yaml'
                sh 'kubectl apply -f k8s/service.yaml'
            }
        }
    }
}
