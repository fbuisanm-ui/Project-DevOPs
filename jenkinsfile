// Jenkinsfile (esquema mínimo)

pipeline {
    agent any

    stages {
        stage('Build') {
            steps {
                sh 'docker build -t miapp:$BUILD_NUMBER .'
            }
        }

        stage('Load Image') {
            steps {
                sh 'sudo -u ubuntu -H minikube image load miapp:$BUILD_NUMBER'
            }
        }

        stage('Deploy') {
            steps {
                sh 'sudo -u ubuntu -H kubectl apply -f k8s/deployment.yaml'
                sh 'sudo -u ubuntu -H kubectl apply -f k8s/service.yaml'
            }
        }
    }
}
